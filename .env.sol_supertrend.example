# Template for .env.sol_supertrend — the sol_supertrend leg's per-instance env.
#
# Copy to `.env.sol_supertrend` (gitignored) and fill in the two secrets.
# `--instance sol_supertrend` loads this file over the base `.env` with
# override=True, so anything set here WINS. The bot refuses to boot a non-v1
# leg without this file (bot._main() per-instance env guard) — that guard exists
# because without it the SOL leg would silently use v1's key and place SOL
# orders inside v1's BTC account.
#
#   cp .env.sol_supertrend.example .env.sol_supertrend
#   $EDITOR .env.sol_supertrend
#
# NOTE: there is no cnh_short key to copy — that leg was never keyed (no
# .env.cnh_short exists). Create a NEW Binance sub-account API key for this leg.
# If a .env.cnh_short does turn out to exist on the droplet, the copy is:
#   sed 's/CONSOLIDATE_SOURCE=.*/CONSOLIDATE_SOURCE=snapback-sol-supertrend/; \
#        s/ALERT_TAG=.*/ALERT_TAG=snapback-sol-st/' \
#     .env.cnh_short > .env.sol_supertrend
# — but verify the key belongs to a sub-account that is NOT the v1 account.

# --- REQUIRED: this leg's own Binance sub-account credentials ---------------
# Futures trading enabled. Withdrawals DISABLED. IP-allowlist the droplet.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- REQUIRED: keep this leg's telemetry and alerts distinguishable ---------
# Without these, dashboard events collide with v1's and every alert email
# threads under v1's subject.
CONSOLIDATE_SOURCE=snapback-sol-supertrend
ALERT_TAG=snapback-sol-st

# --- OPTIONAL ---------------------------------------------------------------
# Inherited from the base .env unless set here. BINANCE_ENV in particular:
# leave unset to inherit, or pin it explicitly if this leg should differ.
# BINANCE_ENV=mainnet
# LOG_LEVEL=INFO
# SYMBOL is read from config/params_sol_supertrend.yaml, not from env.
