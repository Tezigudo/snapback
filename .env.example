# Copy to `.env` and fill in. Never commit `.env`.
# ──────────────────────────────────────────────────

# Environment: testnet | mainnet
# NOTE: Binance Futures testnet/sandbox PRIVATE endpoints are deprecated
# in ccxt (late 2025) — fetch_balance/create_order on testnet now fails.
# Use mainnet with small real capital + `--dry-run` for safe testing.
# Mainnet ALSO requires `confirm_mainnet.lock` file at repo root.
BINANCE_ENV=mainnet

# Binance Futures API keys.
# Mainnet: https://www.binance.com/en/my/settings/api-management
#   - ENABLE: Read, Enable Futures
#   - DISABLE: Withdrawals, Spot, Margin
#   - Restrict to your IP (strongly recommended)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Email alerts via SMTP.
# ⚠ DigitalOcean droplets BLOCK ports 25, 465, and 587 since 2025-03-06 to
# prevent spam. Port 2525 is the only unblocked SMTP port. This rules out
# Gmail SMTP on DO — use a transactional provider (MailerSend, Mailgun,
# SendGrid, Brevo, Postmark, etc.) that exposes port 2525.
#
# Default below = MailerSend (free tier: 3,000 emails/mo, no card):
#   1. Sign up at mailersend.com, verify a domain (or use the trial domain).
#   2. SMTP credentials are under Domains → <your domain> → SMTP.
#   3. Sender (ALERT_EMAIL_FROM) must be on the verified domain; recipient
#      (ALERT_EMAIL_TO) can be any inbox — on trial domain, only the account
#      owner's email is allowed as the recipient.
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Trading symbol (locked to BTC for v1)
SYMBOL=BTC/USDT:USDT

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# investing-consolidate push (optional — Path B integration).
# If BOTH are set, the bot pushes events (boot, heartbeat, dry-run signals,
# entries, exits, kill-switch fires) to consolidate's /bot-event API every
# 30s, so the dashboard's BotStatusCard can render the bot's state.
# If unset, the bot just records events locally to state.db — no pushing,
# no errors. Best-effort: if consolidate is unreachable, events queue in
# state.db `outbox` table and retry on the next push interval.
#   Token = same value as Fly secret API_AUTH_TOKEN.
#   URL   = the consolidate API base (no trailing slash).
CONSOLIDATE_API_URL=
CONSOLIDATE_API_TOKEN=
